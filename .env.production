# Baked into the client bundle at build time by Vite — not secret (these URLs are already
# public in the deployed JS anyway), so unlike .env this file IS committed (see .gitignore)
# so Cloudflare's build (which never sees the local, gitignored .env) has the right values
# instead of silently falling back to the http://localhost:8000 defaults in
# src/infrastructure/config.ts.

VITE_API_BASE_URL=https://talk2me-api.onrender.com/api/v1
VITE_ORT_WASM_BASE_URL=https://cdn.jsdelivr.net/npm/onnxruntime-web/dist/
VITE_YT_TRANSCRIPT_EXTENSION_ID=klncgfkdighdpgopdpddojncnfekbaco
