# ---- Talk2Me UI Environment Configuration ----

# Backend FastAPI URL (bỏ trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ONNX Runtime WASM files (served by the backend)
VITE_ORT_WASM_BASE_URL=http://localhost:8000/ort/

# Chrome extension ID for talk2me-extension (Talk2Me Transcript Helper) — fixed via the
# "key" field in talk2me-extension/manifest.json, so this value is the same regardless of
# who loads the extension or where (see talk2me-extension/README.md). Leave empty to disable
# the extension integration (falls back to the backend's own transcript fetch).
VITE_YT_TRANSCRIPT_EXTENSION_ID=klncgfkdighdpgopdpddojncnfekbaco
